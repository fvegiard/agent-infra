[Unit]
Description=n8n - self-hosted workflow automation (Community Edition)
Documentation=https://docs.n8n.io/hosting/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/francis-v/.local/n8n-npm-global/bin/n8n start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# --- Config (docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/deployment.md) ---
Environment=N8N_HOST=localhost
Environment=N8N_LISTEN_ADDRESS=127.0.0.1
Environment=N8N_PORT=5678
Environment=N8N_PROTOCOL=http
Environment=N8N_DIAGNOSTICS_ENABLED=false
Environment=N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
# --- Security hardening (docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/security.md) ---
Environment=N8N_BLOCK_ENV_ACCESS_IN_NODE=false
Environment=N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# --- Future-proofing: verrouiller les valeurs par defaut avant les changements amont n8n ---
Environment=N8N_UNVERIFIED_PACKAGES_ENABLED=true
Environment=N8N_RUNNERS_TASK_TIMEOUT=300

# --- Secrets: encryption key + owner account bootstrap credentials ---
EnvironmentFile=/home/francis-v/.config/francis/n8n-encryption-key.env
EnvironmentFile=/home/francis-v/.config/francis/n8n-owner-credentials.env
EnvironmentFile=/home/francis-v/.config/francis/dc-webhook-key.env

# --- systemd.exec(5) sandboxing (defense-in-depth; n8n workflow/Code nodes can
#     execute arbitrary JS/shell, so we constrain the unit's blast radius on the
#     host instead of a full VM, per the 2026-09-14 KVM-feasibility ADR).
#     Kept to options that work under an unprivileged `systemctl --user`
#     manager (ProtectKernelTunables/ProtectKernelModules/LockPersonality/etc.
#     require capabilities this user manager doesn't have -> exit 218). ---
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/francis-v/.n8n

[Install]
WantedBy=default.target
